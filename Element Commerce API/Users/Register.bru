meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/users/register
  body: multipartForm
  auth: none
}

body:multipart-form {
  firstName: Alejandro
  lastName: Gómez
  email: alejandro@gmail.com
  password: 123456789
  avatar: @file(/home/alejandro/Imágenes/Capturas de pantalla/Captura desde 2026-07-25 10-31-44.png) @contentType(image/png)
}
