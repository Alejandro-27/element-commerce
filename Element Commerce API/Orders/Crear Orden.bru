meta {
  name: Crear Orden
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders/createOrder
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "items": [
      {
        "product": "ID_DEL_PRODUCTO_AQUI",
        "quantity": 2,
        "price": 10000
      }
    ],
    "paymentInfo": {
      "method": "Credit Card",
      "transactionId": "txn_123456789"
    },
    "shippingAddress": {
      "fullName": "Alejandro Gómez",
      "address": "Calle Principal #123",
      "city": "Ciudad",
      "postalCode": "110111",
      "country": "Colombia",
      "phone": "3001234567"
    }
  }
}
